---
import type { Locale } from '~/site.config';
import { contact, whatsappUrl } from '~/site.config';
import { path } from '~/i18n/routing';
import { useTranslations } from '~/i18n/ui';

interface Props {
  lang: Locale;
  heading?: string;
  text?: string;
  /** Prefills the mail subject with the page context, e.g. a course name. */
  subject?: string;
}
const { lang, heading, text, subject } = Astro.props;
const t = useTranslations(lang);

const waText =
  lang === 'ar'
    ? `أهلًا أحمد، أود الاستفسار عن${subject ? ` ${subject}` : ' برامج مِنوفا'}.`
    : `Hello Ahmed — I'd like to ask about ${subject ?? 'Menova training'}.`;
---

<section class="section section--tight" aria-labelledby="cta-heading">
  <div class="container">
    <div class="cta-band">
      <h2 id="cta-heading">{heading ?? t('heading.contact')}</h2>
      <p>{text ?? t('note.pricing')}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={path('contact', lang)}>
          {t('cta.primary')}
        </a>
        <a class="btn btn--whatsapp" href={whatsappUrl(waText)} rel="noopener" target="_blank">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.5 14.4c-.3-.2-1.8-.9-2-1-.3-.1-.5-.2-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.1-.3-.2-.6-.4M12 2A10 10 0 0 0 2 12a10 10 0 0 0 1.4 5.1L2 22l5-1.3A10 10 0 1 0 12 2" />
          </svg>
          {t('cta.whatsapp')}
        </a>
        <a class="btn btn--secondary" href={contact.linkedin} rel="noopener me" target="_blank">
          {t('cta.linkedin')}
        </a>
      </div>
    </div>
  </div>
</section>
