---
import type { Locale } from '~/site.config';
import { asset, path } from '~/i18n/routing';
import { useTranslations } from '~/i18n/ui';
import { copy } from '~/data/pages';
import { person, badges } from '~/data/person';
import { entriesFor } from '~/i18n/content';
import { graph, personSchema, organizationSchema, breadcrumbSchema, faqSchema } from '~/lib/schema';

import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import PageHeader from '~/components/PageHeader.astro';
import LogoWall from '~/components/LogoWall.astro';
import Faq from '~/components/Faq.astro';
import CtaBand from '~/components/CtaBand.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = copy('about', lang);

/**
 * This page is the hub for the name entity.
 *
 * It carries the fullest Person JSON-LD on the site, the media kit, and
 * internal links out to every other section — so a crawler arriving on any
 * page can reach the canonical description of Ahmed Amrousy in one hop.
 */
const crumbs = [{ name: t('nav.home'), key: '' }];
const jsonLd = graph([
  personSchema(lang),
  organizationSchema(lang),
  breadcrumbSchema([...crumbs, { name: c.title, key: 'about' }], lang),
  faqSchema(c.faqs ?? []),
]);

const updated = new Date('2026-08-27');
// One photo per documented engagement — rendered as the "trainings in action"
// strip. Each ships as a branded placeholder until Ahmed drops the real
// photograph at the same path (see public/images/README.md).
const cases = await entriesFor('caseStudies', lang);
const casePhotos = cases.filter((entry) => entry.data.photos.length > 0);
---

<BaseLayout
  lang={lang}
  routeKey="about"
  title={c.seoTitle}
  description={c.metaDescription}
  jsonLd={jsonLd}
  ogType="profile"
>
  <Breadcrumbs lang={lang} crumbs={crumbs} current={c.title} />
  <PageHeader lang={lang} eyebrow={c.eyebrow} title={c.title} summary={c.summary} updated={updated} />

  <section class="section section--tight">
    <div class="container grid grid--sidebar">
      <div>
        <p class="lede" style="font-weight:600;color:var(--ink)">“{person.tagline[lang]}”</p>
        <div class="prose" style="margin-block-start:2rem">
          <p>{person.bios[lang].long}</p>
        </div>
      </div>
      <aside>
        {/* TODO: replace with the real headshot — see public/images/README.md */}
        <img
          class="hero__portrait"
          src={asset('images/ahmed-amrousy-headshot.jpg')}
          alt={`${person.name} — ${person.jobTitle[lang]}`}
          width="640"
          height="800"
          loading="lazy"
          decoding="async"
        />
        <p style="margin-block-start:1rem">
          <a class="btn btn--secondary" href={asset('downloads/ahmed-amrousy-profile.pdf')} download>
            {t('cta.download')}
          </a>
        </p>

        {/* Official AUC Executive Education instructor badges, two academic years. */}
        <div class="badges" aria-label={lang === 'ar' ? 'شارات التدريس بالجامعة الأمريكية' : 'AUC teaching badges'}>
          {badges.map((badge) => (
            <img
              src={asset(badge.file)}
              alt={badge.alt[lang]}
              width={badge.width}
              height={badge.height}
              loading="lazy"
              decoding="async"
            />
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--tinted" aria-labelledby="roles-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="roles-heading">{lang === 'ar' ? 'المواقع الحالية' : 'Current roles'}</h2>
      </div>
      <div class="grid grid--3">
        {
          person.roles.map((role) => (
            <article class="card card--flag">
              <p class="eyebrow" style="margin:0">{role.title[lang]}</p>
              <h3>{role.org[lang]}</h3>
              <p class="muted">{role.unit[lang]}</p>
              {'note' in role && role.note && <p>{role.note[lang]}</p>}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="credentials-heading">
    <div class="container grid grid--2">
      <div>
        <h2 id="credentials-heading">{lang === 'ar' ? 'المؤهلات' : 'Credentials'}</h2>
        <dl class="spec" style="margin-block-start:1.5rem">
          {
            person.education.map((item) => (
              <div>
                <dt>{item.degree[lang]}</dt>
                <dd>{item.org[lang] || '—'}</dd>
              </div>
            ))
          }
          {
            person.memberships.map((item) => (
              <div>
                <dt>{lang === 'ar' ? 'عضوية' : 'Membership'}</dt>
                <dd>{item[lang]}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div>
        <h2>{lang === 'ar' ? 'الخبرة الصناعية' : 'Industry experience'}</h2>
        <p class="lede" style="margin-block-start:0.75rem">
          {person.industryExperience.years} {lang === 'ar' ? 'عامًا في قيادة التسويق' : 'years of marketing leadership'}
        </p>
        <dl class="spec" style="margin-block-start:1rem">
          {
            person.industryExperience.sectors.map((sector) => (
              <div>
                <dt>{sector[lang]}</dt>
                <dd>{sector.orgs.length ? sector.orgs.join(' · ') : '—'}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {/* ── Trainings in action ─────────────────────────────────────────────── */}
  <section class="section" aria-labelledby="in-action-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="in-action-heading">{lang === 'ar' ? 'من داخل القاعات' : 'Trainings in action'}</h2>
      </div>
      <div class="grid grid--2">
        {
          casePhotos.map((entry) => (
            <a class="action-photo" href={path(`case-studies/${entry.slug}`, lang)}>
              {/* alt is empty on purpose: the visible caption right below
                  carries the same text, and duplicating it fails WCAG 1.1.1
                  (redundant alt). */}
              <img
                src={asset(entry.data.photos[0]!.src)}
                alt=""
                width={entry.data.photos[0]!.width}
                height={entry.data.photos[0]!.height}
                loading="lazy"
                decoding="async"
              />
              <span class="action-photo__caption">{entry.data.title}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <LogoWall lang={lang} />

  {/* ── Media kit ───────────────────────────────────────────────────────── */}
  <section class="section" aria-labelledby="media-kit-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="media-kit-heading">{c.mediaKitHeading}</h2>
        <p class="lede">{c.mediaKitNote}</p>
      </div>

      <div class="grid grid--3">
        <article class="card">
          <h3>{lang === 'ar' ? 'نبذة قصيرة (50 كلمة)' : 'Short bio (50 words)'}</h3>
          <p>{person.bios[lang].short}</p>
        </article>
        <article class="card">
          <h3>{lang === 'ar' ? 'نبذة متوسطة (100 كلمة)' : 'Medium bio (100 words)'}</h3>
          <p>{person.bios[lang].medium}</p>
        </article>
        <article class="card">
          <h3>{lang === 'ar' ? 'الألقاب المعتمدة' : 'Approved titles'}</h3>
          <ul>
            {person.approvedTitles[lang].map((title) => <li>{title}</li>)}
          </ul>
        </article>
      </div>

      <div class="btn-row" style="margin-block-start:1.5rem">
        <a class="btn btn--secondary" href={asset('downloads/ahmed-amrousy-profile.pdf')} download>
          {t('cta.download')}
        </a>
        <a class="btn btn--ghost" href={path('speaking', lang)}>{t('nav.speaking')}</a>
      </div>
    </div>
  </section>

  <section class="section section--tinted" aria-labelledby="other-heading">
    <div class="container grid grid--3">
      <article>
        <h2 id="other-heading">{person.otherWork.podcast.name}</h2>
        <p style="margin-block-start:0.75rem">{person.otherWork.podcast.description[lang]}</p>
        <p style="margin-block-start:1rem">
          <a class="btn btn--ghost" href={path('podcast', lang)}>{t('nav.podcast')}</a>
        </p>
      </article>
      <article>
        <h2>{person.otherWork.television.label[lang]}</h2>
        <p style="margin-block-start:0.75rem">{person.otherWork.television.description[lang]}</p>
        <p style="margin-block-start:1rem">
          <a class="btn btn--secondary" href={person.otherWork.television.url} rel="noopener" target="_blank">
            {lang === 'ar' ? 'شاهد المقابلة' : 'Watch the interview'}
          </a>
        </p>
      </article>

      <article class="athlete">
        <img
          class="athlete__photo"
          src={asset('images/ahmed-amrousy-running.jpg')}
          alt={lang === 'ar' ? 'أحمد عمروسي أثناء أحد السباقات' : 'Ahmed Amrousy mid-race'}
          width="900"
          height="1641"
          loading="lazy"
          decoding="async"
        />
        <div>
          <h2>{lang === 'ar' ? 'خارج العمل' : 'Outside work'}</h2>
          <p style="margin-block-start:0.75rem">{person.otherWork.sport[lang]}</p>
        </div>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="about-faq">
    <div class="container container--narrow">
      <h2 id="about-faq" style="margin-block-end:1.5rem">{t('heading.faq')}</h2>
      <Faq lang={lang} faqs={c.faqs ?? []} showHeading={false} />
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .badges {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-s);
    margin-block-start: var(--space-m);
    flex-wrap: wrap;
  }
  .badges img {
    width: clamp(7rem, 40%, 9.5rem);
    height: auto;
  }
  .action-photo {
    position: relative;
    display: block;
    border-radius: var(--radius-l);
    overflow: hidden;
    border: 1px solid var(--line);
    text-decoration: none;
  }
  .action-photo img {
    width: 100%;
    /* Fixed tile so the strip stays a tidy grid across mixed aspect ratios. */
    aspect-ratio: 3 / 2;
    object-fit: cover;
    height: auto;
    display: block;
    transition: transform 0.25s ease;
  }
  .action-photo:hover img {
    transform: scale(1.02);
  }
  .action-photo__caption {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    padding: 2.25rem var(--space-m) var(--space-s);
    background: linear-gradient(180deg, transparent, rgb(12 43 31 / 0.85));
    color: #fff;
    font-weight: 650;
    font-size: var(--step-0);
  }
  .athlete {
    display: grid;
    gap: var(--space-m);
    align-items: start;
  }
  @media (min-width: 640px) {
    .athlete {
      grid-template-columns: minmax(0, 14rem) 1fr;
    }
  }
  .athlete__photo {
    border-radius: var(--radius-l);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-m);
  }
</style>
