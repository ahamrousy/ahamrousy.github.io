---
import type { Locale } from '~/site.config';
import { contact, mailtoUrl } from '~/site.config';
import { useTranslations } from '~/i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * Proposal-request form with no backend.
 *
 * GitHub Pages serves static files only, so there is nothing to POST to. Two
 * modes, decided by `contact.formspreeId`:
 *
 *   1. **Formspree configured** — the form POSTs there and the submission
 *      arrives as an email. Nothing else to change.
 *   2. **Not configured (the default)** — the entered values are composed into
 *      a structured WhatsApp message and sent to Ahmed.
 *
 * The fallback used to compose a `mailto:` instead. That was replaced because
 * a mailto only works when the visitor has a desktop mail client configured —
 * on a phone, or in a browser without one, the link silently does nothing and
 * the enquiry is lost. WhatsApp is the channel Ahmed actually monitors and it
 * works on every device, so the default path now goes there.
 */
const formspreeAction = contact.formspreeId ? `https://formspree.io/f/${contact.formspreeId}` : '';
const waNumber = contact.whatsappNumber;

const l = {
  en: {
    name: 'Your name',
    email: 'Work email',
    org: 'Organisation',
    size: 'Team size and seniority',
    city: 'City and preferred dates',
    goal: 'What should the team be able to do afterwards?',
    language: 'Preferred delivery language',
    langArabic: 'Arabic delivery, English slides',
    langEnglish: 'Full English',
    langEither: 'Either is fine',
    submit: 'Send on WhatsApp',
    required: 'required',
    fallbackNote:
      'Opens WhatsApp with your details filled in — review it, then press send.',
    or: 'Prefer email?',
  },
  ar: {
    name: 'الاسم',
    email: 'بريد العمل',
    org: 'الجهة',
    size: 'عدد المشاركين ومستواهم الوظيفي',
    city: 'المدينة والتواريخ المفضلة',
    goal: 'ما الذي تريد أن يصبح الفريق قادرًا عليه بعد التدريب؟',
    language: 'لغة التقديم المفضلة',
    langArabic: 'شرح بالعربية وشرائح إنجليزية',
    langEnglish: 'إنجليزية بالكامل',
    langEither: 'كلاهما مناسب',
    submit: 'أرسل على واتساب',
    required: 'مطلوب',
    fallbackNote: 'يفتح واتساب ببياناتك مُعبَّأة — راجعها ثم اضغط إرسال.',
    or: 'تفضّل البريد الإلكتروني؟',
  },
}[lang];
---

<form
  class="contact-form"
  id="contact-form"
  method="POST"
  action={formspreeAction}
  data-mode={formspreeAction ? 'formspree' : 'whatsapp'}
  data-wa={waNumber}
  data-intro={lang === 'ar'
    ? 'أهلًا أحمد — أود طلب عرض تدريبي.'
    : 'Hello Ahmed — I would like to request a training proposal.'}
>
  <div class="field">
    <label for="cf-name">{l.name}</label>
    <input id="cf-name" name="name" type="text" autocomplete="name" required />
  </div>

  <div class="field">
    <label for="cf-email">{l.email}</label>
    <input id="cf-email" name="email" type="email" autocomplete="email" required />
  </div>

  <div class="field">
    <label for="cf-org">{l.org}</label>
    <input id="cf-org" name="organisation" type="text" autocomplete="organization" required />
  </div>

  <div class="field">
    <label for="cf-size">{l.size}</label>
    <input id="cf-size" name="team" type="text" />
  </div>

  <div class="field">
    <label for="cf-language">{l.language}</label>
    <select id="cf-language" name="language">
      <option value={l.langArabic}>{l.langArabic}</option>
      <option value={l.langEnglish}>{l.langEnglish}</option>
      <option value={l.langEither}>{l.langEither}</option>
    </select>
  </div>

  <div class="field">
    <label for="cf-city">{l.city}</label>
    <input id="cf-city" name="city" type="text" />
  </div>

  <div class="field">
    <label for="cf-goal">{l.goal}</label>
    <textarea id="cf-goal" name="objective" rows="4"></textarea>
  </div>

  {/* Honeypot — bots fill it, people never see it. Formspree also honours _gotcha. */}
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="honeypot" />
  <input type="hidden" name="_subject" value="Menova — training enquiry" />

  <button type="submit" class={formspreeAction ? 'btn btn--primary' : 'btn btn--whatsapp'}>{l.submit}</button>
  {!formspreeAction && <p class="muted form-note">{l.fallbackNote}</p>}
</form>

<p class="muted form-alt">
  {l.or}
  <a href={mailtoUrl(`Menova — ${t('cta.proposal')}`, t('note.proposalBody'))}>{contact.email}</a>
</p>

<script>
  /**
   * WhatsApp fallback. Only runs when no Formspree ID is configured — with one
   * present, the form POSTs normally and this listener does nothing.
   *
   * Field labels are read out of the DOM, so the message reaches Ahmed in
   * whichever language the visitor was reading.
   */
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form && form.dataset.mode === 'whatsapp') {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      if (data.get('_gotcha')) return; // bot

      const lines: string[] = [form.dataset.intro ?? '', ''];
      for (const [key, value] of data.entries()) {
        if (key.startsWith('_') || typeof value !== 'string' || !value.trim()) continue;
        const label = form.querySelector(`label[for="cf-${key === 'organisation' ? 'org' : key}"]`);
        lines.push(`${label?.textContent?.trim() ?? key}: ${value}`);
      }

      const url = `https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(lines.join('\n'))}`;
      window.open(url, '_blank', 'noopener');
    });
  }
</script>

<style>
  .contact-form {
    display: grid;
    gap: var(--space-s);
    max-width: 34rem;
    margin-block-start: var(--space-m);
  }
  .field {
    display: grid;
    gap: 0.3rem;
  }
  .field label {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
  }
  .field :is(input, select, textarea) {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    padding: 0.55rem 0.7rem;
    background: var(--paper);
    font-size: var(--step-0);
  }
  .field :is(input, select, textarea):focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 0;
    border-color: var(--green);
  }
  .field textarea {
    resize: vertical;
    min-height: 5rem;
  }
  .honeypot {
    position: absolute !important;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .contact-form .btn {
    justify-self: start;
  }
  .form-note {
    margin-block-start: -0.25rem;
  }
  .form-alt {
    margin-block-start: var(--space-s);
  }
  .form-alt a {
    color: var(--green-dark);
    font-weight: 600;
  }
</style>
