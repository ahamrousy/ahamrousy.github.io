---
/**
 * The official Menova mark — green shield with the coral dot, cropped from
 * the master logo file. The same artwork feeds the favicon, the touch icon,
 * the PDF masthead and the OG cards, so the brand renders identically
 * everywhere. Replace public/images/menova-mark.png (and menova-logo.png)
 * to rebrand; nothing else changes.
 */
import { asset } from '~/i18n/routing';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<img
  class={className}
  src={asset('images/menova-mark.png')}
  alt=""
  width="160"
  height="103"
  aria-hidden="true"
  decoding="async"
/>
