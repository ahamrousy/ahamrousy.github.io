---
/**
 * The Menova mark: two strokes meeting at a point to form an "M" — crimson
 * for the brand, green for the second stroke. Inline SVG so it costs no
 * request and inherits crisp rendering at any size.
 *
 * The same geometry is redrawn in public/images/menova-logo.svg (for JSON-LD
 * and OG) and in public/favicon.svg. Change one, change all three.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <path d="M5 26V7l11 12" stroke="#9B1B30" stroke-width="4.2" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M27 26V7L16 19" stroke="#1B7A4A" stroke-width="4.2" stroke-linecap="round" stroke-linejoin="round" />
</svg>
