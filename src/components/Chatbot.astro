---
import type { Locale } from '~/site.config';
import { whatsappUrl } from '~/site.config';
import { path } from '~/i18n/routing';
import { useTranslations } from '~/i18n/ui';
import { intents, starterQuestions } from '~/data/chatbot';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// The knowledge base is resolved to the current language on the server, so the
// browser only ever downloads the half it needs, with links already turned
// into real hrefs.
const kb = intents.map((intent) => ({
  id: intent.id,
  p: intent.patterns[lang],
  a: intent.answer[lang],
  l: (intent.links ?? []).map((link) => ({ href: path(link.key, lang), label: link.label[lang] })),
}));

const starters = starterQuestions[lang];

const waHref = whatsappUrl(
  lang === 'ar'
    ? 'أهلًا أحمد، وصلتني من موقع مِنوفا وعندي استفسار عن التدريب.'
    : 'Hello Ahmed — I came from the Menova site and have a question about training.',
);

const payload = {
  kb,
  starters,
  strings: {
    fallback: t('chat.fallback'),
    greeting: t('chat.greeting'),
    wa: t('chat.whatsapp'),
    waHref,
  },
};
---

<div class="chat" id="menova-chat" data-lang={lang}>
  <button
    type="button"
    class="chat__toggle"
    id="chat-toggle"
    aria-expanded="false"
    aria-controls="chat-panel"
    aria-label={t('chat.open')}
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.6-.7L3 21l1.9-5A8.2 8.2 0 0 1 4 11.5a8.4 8.4 0 0 1 9-8.4 8.4 8.4 0 0 1 8 8.4z" />
    </svg>
    <span class="chat__toggle-text">{t('chat.title')}</span>
  </button>

  <div class="chat__panel" id="chat-panel" role="dialog" aria-label={t('chat.title')} hidden>
    <div class="chat__header">
      <div>
        <p class="chat__title">{t('chat.title')}</p>
        <p class="chat__subtitle">{t('chat.subtitle')}</p>
      </div>
      <button type="button" class="chat__close" id="chat-close" aria-label={t('chat.close')}>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
          <path d="M4 4l10 10M14 4L4 14" />
        </svg>
      </button>
    </div>

    <div class="chat__log" id="chat-log" role="log" aria-live="polite" aria-label={t('a11y.chatLog')}></div>

    <div class="chat__chips" id="chat-chips" aria-label={t('chat.suggestions')}></div>

    <form class="chat__form" id="chat-form">
      <label class="visually-hidden" for="chat-input">{t('chat.placeholder')}</label>
      <input
        id="chat-input"
        name="message"
        type="text"
        autocomplete="off"
        placeholder={t('chat.placeholder')}
      />
      <button type="submit" class="chat__send" aria-label={t('chat.send')}>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path class="chat__send-icon" d="M2 9h13M10 4l5 5-5 5" />
        </svg>
      </button>
    </form>

    <div class="chat__footer">
      <a class="btn btn--whatsapp chat__wa" href={waHref} rel="noopener" target="_blank">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.5 14.4c-.3-.2-1.8-.9-2-1-.3-.1-.5-.2-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.1-.3-.2-.6-.4M12 2A10 10 0 0 0 2 12a10 10 0 0 0 1.4 5.1L2 22l5-1.3A10 10 0 1 0 12 2" />
        </svg>
        {t('chat.whatsapp')}
      </a>
      <p class="chat__disclaimer">{t('chat.disclaimer')}</p>
    </div>
  </div>
</div>

<script type="application/json" id="chat-data" is:inline set:html={JSON.stringify(payload)} />

<script>
  /**
   * Menova assistant — deterministic keyword matcher.
   *
   * No network calls, no API key, no model. It scores the visitor's message
   * against a fixed pattern list and replies with a pre-written answer, or
   * hands off to WhatsApp. Two consecutive misses trigger the handoff
   * automatically, which is the behaviour the brief asked for.
   */
  interface KBLink {
    href: string;
    label: string;
  }
  interface KBEntry {
    id: string;
    p: string[];
    a: string;
    l: KBLink[];
  }
  interface Payload {
    kb: KBEntry[];
    starters: Array<{ label: string; intent: string }>;
    strings: { fallback: string; greeting: string; wa: string; waHref: string };
  }

  const root = document.getElementById('menova-chat');
  const dataEl = document.getElementById('chat-data');
  if (root && dataEl?.textContent) {
    const data: Payload = JSON.parse(dataEl.textContent);
    const toggle = document.getElementById('chat-toggle') as HTMLButtonElement;
    const closeBtn = document.getElementById('chat-close') as HTMLButtonElement;
    const panel = document.getElementById('chat-panel') as HTMLElement;
    const log = document.getElementById('chat-log') as HTMLElement;
    const chips = document.getElementById('chat-chips') as HTMLElement;
    const form = document.getElementById('chat-form') as HTMLFormElement;
    const input = document.getElementById('chat-input') as HTMLInputElement;

    /**
     * Arabic normalisation: strip tashkeel, unify the alef forms, fold ta
     * marbuta to ha and alef maqsura to ya. Without this, "الإمارات" typed
     * with a hamza never matches "الامارات" in the pattern list.
     */
    const normalise = (value: string): string =>
      value
        .toLowerCase()
        .replace(/[ً-ْٰ]/g, '')
        .replace(/[آأإٱ]/g, 'ا')
        .replace(/ة/g, 'ه')
        .replace(/ى/g, 'ي')
        .replace(/[‌-‏]/g, '')
        .replace(/[^\p{L}\p{N}\s]/gu, ' ')
        .replace(/\s+/g, ' ')
        .trim();

    const kb = data.kb.map((entry) => ({ ...entry, p: entry.p.map(normalise) }));

    let misses = 0;
    let opened = false;

    function bubble(text: string, who: 'bot' | 'user'): HTMLElement {
      const el = document.createElement('div');
      el.className = `chat__msg chat__msg--${who}`;
      el.textContent = text;
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return el;
    }

    function addLinks(links: KBLink[]): void {
      if (!links.length) return;
      const wrap = document.createElement('div');
      wrap.className = 'chat__links';
      for (const link of links) {
        const a = document.createElement('a');
        a.href = link.href;
        a.textContent = link.label;
        wrap.appendChild(a);
      }
      log.appendChild(wrap);
      log.scrollTop = log.scrollHeight;
    }

    function addWhatsApp(): void {
      const wrap = document.createElement('div');
      wrap.className = 'chat__links';
      const a = document.createElement('a');
      a.href = data.strings.waHref;
      a.target = '_blank';
      a.rel = 'noopener';
      a.className = 'chat__links--wa';
      a.textContent = data.strings.wa;
      wrap.appendChild(a);
      log.appendChild(wrap);
      log.scrollTop = log.scrollHeight;
    }

    /** Longer patterns win: "how much" should beat a bare "how". */
    function match(query: string): KBEntry | null {
      const q = normalise(query);
      if (!q) return null;
      let best: KBEntry | null = null;
      let bestScore = 0;
      for (const entry of kb) {
        let score = 0;
        for (const pattern of entry.p) {
          if (pattern && q.includes(pattern)) score += pattern.length;
        }
        if (score > bestScore) {
          bestScore = score;
          best = entry;
        }
      }
      return best;
    }

    function respond(query: string): void {
      const hit = match(query);
      if (hit) {
        misses = 0;
        bubble(hit.a, 'bot');
        addLinks(hit.l);
      } else {
        misses += 1;
        bubble(data.strings.fallback, 'bot');
        addWhatsApp();
        // After two dead ends, stop guessing and keep the handoff on screen.
        if (misses >= 2) chips.innerHTML = '';
      }
    }

    function renderChips(): void {
      chips.innerHTML = '';
      for (const starter of data.starters) {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'chat__chip';
        chip.textContent = starter.label;
        chip.addEventListener('click', () => {
          bubble(starter.label, 'user');
          const entry = kb.find((item) => item.id === starter.intent);
          if (entry) {
            misses = 0;
            bubble(entry.a, 'bot');
            addLinks(entry.l);
          } else {
            respond(starter.label);
          }
          chip.remove();
        });
        chips.appendChild(chip);
      }
    }

    function open(): void {
      panel.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      if (!opened) {
        opened = true;
        bubble(data.strings.greeting, 'bot');
        renderChips();
      }
      input.focus();
    }

    function close(): void {
      panel.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.focus();
    }

    toggle.addEventListener('click', () => (panel.hidden ? open() : close()));
    closeBtn.addEventListener('click', close);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) close();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const value = input.value.trim();
      if (!value) return;
      bubble(value, 'user');
      input.value = '';
      respond(value);
    });
  }
</script>

<style>
  .chat {
    position: fixed;
    inset-block-end: 1rem;
    inset-inline-end: 1rem;
    z-index: 150;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
    font-size: 0.94rem;
  }
  html[dir='rtl'] .chat {
    align-items: flex-start;
  }

  .chat__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--crimson);
    color: #fff;
    border: 0;
    border-radius: 999px;
    padding: 0.7rem 1.1rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: var(--shadow-l);
    transition: background-color 0.15s ease, transform 0.15s ease;
  }
  .chat__toggle:hover {
    background: var(--crimson-dark);
    transform: translateY(-2px);
  }
  @media (max-width: 420px) {
    .chat__toggle-text {
      display: none;
    }
    .chat__toggle {
      padding: 0.85rem;
    }
  }

  .chat__panel {
    width: min(23rem, calc(100vw - 2rem));
    max-height: min(32rem, calc(100vh - 6rem));
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-l);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    order: -1;
  }
  .chat__panel[hidden] {
    display: none;
  }

  .chat__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.85rem 1rem;
    background: var(--ink);
    color: #fff;
  }
  .chat__title {
    font-weight: 650;
    line-height: 1.3;
  }
  .chat__subtitle {
    font-size: 0.8rem;
    color: rgb(255 255 255 / 0.65);
    line-height: 1.4;
  }
  .chat__close {
    background: none;
    border: 0;
    color: rgb(255 255 255 / 0.7);
    cursor: pointer;
    padding: 0.2rem;
    flex-shrink: 0;
  }
  .chat__close:hover {
    color: #fff;
  }

  .chat__log {
    flex: 1;
    overflow-y: auto;
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 8rem;
  }
  .chat__msg {
    padding: 0.55rem 0.8rem;
    border-radius: var(--radius-l);
    max-width: 88%;
    line-height: 1.55;
  }
  .chat__msg--bot {
    background: var(--paper-3);
    color: var(--ink);
    align-self: flex-start;
    border-start-start-radius: var(--radius-s);
  }
  .chat__msg--user {
    background: var(--crimson);
    color: #fff;
    align-self: flex-end;
    border-end-end-radius: var(--radius-s);
  }

  .chat__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-self: flex-start;
  }
  .chat__links a {
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--crimson);
    border: 1px solid rgb(155 27 48 / 0.25);
    background: var(--crimson-tint);
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
  }
  .chat__links a:hover {
    background: var(--crimson);
    color: #fff;
  }
  .chat__links a.chat__links--wa {
    color: var(--green-dark);
    border-color: rgb(27 122 74 / 0.3);
    background: var(--green-tint);
  }
  .chat__links a.chat__links--wa:hover {
    background: var(--green);
    color: #fff;
  }

  .chat__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0 0.85rem 0.6rem;
  }
  .chat__chip {
    font-size: 0.82rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    cursor: pointer;
    text-align: start;
  }
  .chat__chip:hover {
    border-color: var(--crimson);
    color: var(--crimson);
  }

  .chat__form {
    display: flex;
    gap: 0.4rem;
    padding: 0.6rem 0.85rem;
    border-block-start: 1px solid var(--line);
  }
  .chat__form input {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    padding: 0.5rem 0.7rem;
    background: var(--paper-2);
  }
  .chat__form input:focus {
    outline: 2px solid var(--crimson);
    outline-offset: 0;
    background: var(--paper);
  }
  .chat__send {
    background: var(--ink);
    color: #fff;
    border: 0;
    border-radius: var(--radius-m);
    padding-inline: 0.75rem;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .chat__send:hover {
    background: var(--crimson);
  }
  html[dir='rtl'] .chat__send-icon {
    transform: scaleX(-1);
    transform-origin: center;
  }

  .chat__footer {
    padding: 0.6rem 0.85rem 0.85rem;
    border-block-start: 1px solid var(--line);
    background: var(--paper-2);
  }
  .chat__wa {
    width: 100%;
    font-size: 0.9rem;
    padding: 0.55em 1em;
  }
  .chat__disclaimer {
    font-size: 0.74rem;
    color: var(--ink-3);
    margin-block-start: 0.45rem;
    text-align: center;
    line-height: 1.4;
  }

  @media print {
    .chat {
      display: none;
    }
  }
</style>
